# .env.production is currently tracked on purpose — it holds only public
# Stripe Payment Link URLs. These entries cover the neighbouring filenames a
# real secret would otherwise land in silently: .dev.vars is where wrangler
# reads local Worker secrets, and .wrangler/ caches local state.
.env.development
