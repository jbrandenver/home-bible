# Stripe Payment Links (live mode, created 2026-08-03). These are PUBLIC
# values — they render into anchor hrefs on /pricing, /pro, and Settings —
# which is why they are committed rather than configured as host secrets.
# Each link carries product_key metadata the stripe-webhook function keys off.
# Inlined at build time (NEXT_PUBLIC_*); a redeploy picks up changes.
NEXT_PUBLIC_STRIPE_PORTFOLIO_PAYMENT_LINK=https://buy.stripe.com/7sY28s9L2dFM0G331b6Zy00
NEXT_PUBLIC_STRIPE_PER_HOME_PAYMENT_LINK=https://buy.stripe.com/4gMeVee1i59gbkH1X76Zy01
NEXT_PUBLIC_STRIPE_PRO_BINDER_PAYMENT_LINK=https://buy.stripe.com/5kQcN62iAfNUewTdFP6Zy02
