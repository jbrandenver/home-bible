# Our Home Folder — every environment variable the code reads.
#
# This file is the checklist. A deploy that silently omits one of these does
# not fail loudly, it fails quietly: the 2026-08-04 audit found that a missing
# DIGEST_CRON_SECRET used to turn the digest sender into an unauthenticated
# public endpoint. That specific hole is now fail-closed, but the general rule
# stands — if the code reads it, it belongs here.
#
# Two groups, and the split matters:
#   1. NEXT_PUBLIC_* are inlined into the browser bundle at build time. They
#      are world-readable. Never put a secret here.
#   2. Function secrets are set with `supabase secrets set` and never live in
#      this repo in any form.

# ---------------------------------------------------------------------------
# 1. Web app — build-time, PUBLIC (shipped to every visitor's browser)
# ---------------------------------------------------------------------------

# Supabase project API origin, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable ("anon") key. Public by design — RLS is the security boundary,
# not this key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site origin, used for SEO/OG tags and absolute links.
NEXT_PUBLIC_SITE_URL=https://ourhomefolder.com
# Comma-separated OAuth providers to offer on the sign-in page, e.g. "google".
# Empty means email/password only.
NEXT_PUBLIC_OAUTH_PROVIDERS=
# Stripe Payment Link URLs (buy.stripe.com/...). Public by design: they are
# rendered into anchor hrefs. NOT secret keys.
NEXT_PUBLIC_STRIPE_PORTFOLIO_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_PER_HOME_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_PRO_BINDER_PAYMENT_LINK=

NODE_ENV=development

# ---------------------------------------------------------------------------
# 2. Supabase Edge Function secrets — NEVER commit real values, never prefix
#    any of these with NEXT_PUBLIC_. Set with:
#      supabase secrets set NAME=value
# ---------------------------------------------------------------------------

# Platform-injected in deployed functions; needed only for local
# `supabase functions serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses ALL row-level security. Edge functions only. If this ever reaches a
# browser bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (stripe-webhook)
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint. Without it the webhook refuses every
# request rather than trusting unsigned events.
STRIPE_WEBHOOK_SIGNING_SECRET=

# Email (send-digest, via Resend)
RESEND_API_KEY=
DIGEST_FROM=Our Home Folder <reminders@send.ourhomefolder.com>
# CAN-SPAM requires a physical postal address on every marketing email. Use a
# PO box or virtual mailbox — never a home address.
POSTAL_ADDRESS=
# Absolute origin used in email links and function-rendered pages.
SITE_URL=https://ourhomefolder.com

# Shared secrets for the pg_cron-invoked functions. Both endpoints are public
# (cron cannot present a user JWT), so these are the only thing standing
# between the internet and a send loop / a write into recall_matches. Both
# functions refuse to run when their secret is unset. Use 32+ random bytes:
# `openssl rand -hex 32`.
DIGEST_CRON_SECRET=
RECALL_CRON_SECRET=

# HMAC key for one-click unsubscribe links. Rotating it invalidates every
# unsubscribe link already sitting in someone's inbox.
UNSUBSCRIBE_SECRET=

# Vision model for the appliance data-plate scanner (analyze-plate). The
# feature refuses with a 503 until this is set — it is opt-in spend.
ANTHROPIC_API_KEY=
