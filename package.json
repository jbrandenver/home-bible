{
  "name": "home-folder-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter @home-folder/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @home-folder/web typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @home-folder/web test",
    "security:audit": "bash scripts/security-cost-audit.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^8.57.1",
    "typescript": "^5.1.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
